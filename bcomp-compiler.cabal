cabal-version:      3.0

name:               bcomp-compiler

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

license:            MIT
license-file:       LICENSE
author:             mp2720
category:           Language
build-type:         Simple

common shared-properties
    ghc-options: -Wall
    default-language: Haskell2010
    build-depends:
        base ^>= 4.18.3.0,
        transformers ^>= 0.6.3.0,
        containers ^>= 0.8,
        basic-lens ^>= 0.0.2,
        directory ^>= 1.3.10.1        
library
    import: shared-properties
    exposed-modules:
        Parse.Combinators
        Parse.Lexer
        Parse.Grammar
        AST
    other-modules:
        IR
        IR.Scope
        IR.FromAST
        Diagnostics
        ID
        CFG
        CFG.FromIR
        CFG.Graphviz
        Opt.UnusedVars

    hs-source-dirs: app

executable bcomp-compiler
    import: shared-properties
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends: bcomp-compiler
    other-modules:
        Parse.Combinators
        Parse.Lexer
        Parse.Grammar
        AST
        IR
        IR.Scope
        IR.FromAST
        Diagnostics
        ID
        CFG
        CFG.FromIR
        CFG.Graphviz
        Opt.UnusedVars

Test-suite test
    import: shared-properties
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Spec.hs
    other-modules: LexerSpec GrammarSpec
    build-depends:
        hspec ^>= 2.11.12,
        hspec-discover ^>= 2.11.12,
        raw-strings-qq ^>= 1.1,
        bcomp-compiler
    build-tool-depends: hspec-discover:hspec-discover ^>= 2.11.12
